<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!--
        allowBackup=false — намеренно, и это не мелочь.

        При значении true Android сам, без спроса и без уведомления, отправляет
        данные приложения в облако Google: и хранилище WebView с давлением,
        сахаром и аптечкой, и файл резервной копии. Приложение при этом прямым
        текстом обещает в настройках, что данные никуда не уходят. На этом же
        обещании держится и правовой статус: пока данные не покидают устройство,
        152-ФЗ на нас не распространяется — обработки с нашей стороны нет.

        Автокопия Google шифруется ключом от блокировки экрана и посторонним не
        видна, но устройство данные всё равно покидают. Обещание должно быть
        правдой, а не приблизительной.

        Взамен человеку остаётся ровно то, что он делает осознанно: копия
        файлом, которую он сам отправляет туда, куда захочет.
    -->
    <!-- Кому система может отдать ссылку. Нужно с Android 11: без объявления
         приложение не видит ни браузеров, ни приложений аптек, и открыть
         ссылку не может вовсе. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Системные экраны, которые приложение проверяет перед переходом.
             Без объявления `queryIntentActivities` отвечает «такого экрана
             нет» даже там, где он есть, и цепочка запасных путей сразу
             сваливалась бы в последний. -->
        <intent>
            <action android:name="android.settings.CHANNEL_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Разрешения -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Bluetooth Low Energy: чтение измерений с тонометра.

        Android 12 и новее. `neverForLocation` — обещание системе, что мы не
        выводим местоположение человека из результатов сканирования. Без него у
        дневника давления запрашивался бы доступ к геолокации, а это пугает и
        вызывает отказ. Взамен система отфильтровывает часть маячков; для
        прибора, объявляющего свой сервис, это не помеха, но проверить на живом
        тонометре обязательно: если он перестанет находиться, причина здесь.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"
    />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Android 11 и старше. Там разрешения на устройства поблизости ещё нет, а
        сканирование без доступа к местоположению возвращает пустой список —
        причём мало выдать разрешение, должна быть включена и сама служба
        геолокации. Ограничены `maxSdkVersion`, чтобы на современных телефонах
        не запрашиваться вовсе.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
        Геолокацию объявляем сами и с ограничением по версии.

        Плагин BLE просит обе — и точную, и приблизительную — без всякого предела,
        потому что рассчитан на любые сценарии. Нам она нужна ровно для одного:
        на Android 11 и старше без неё не работает сканирование. На Android 12+
        мы обещали системе `neverForLocation`, и незакрытое разрешение это
        обещание перечёркивало бы: в карточке магазина дневник давления выглядел
        бы приложением, которое следит за перемещениями.
    -->
    <!--
        Точное время напоминания — по разрешению человека, не по умолчанию.

        Сначала это разрешение было снято: казалось, что напоминанию о таблетке
        секундная точность ни к чему. Замер на живом телефоне это опроверг.
        Неточный будильник система выдаёт с окном, которое растёт со временем:
        на HUAWEI напоминание на 23:59 получило окно в десять минут, на 00:14 —
        в двадцать две, и поверх этого политика app_standby сдвигала его ещё.
        При таком разбросе повторы через пятнадцать минут слипаются, а «принять
        в восемь» превращается в «где-то между восемью и половиной девятого».

        Поэтому разрешение объявлено, но приложение его не выпрашивает само:
        плагин по умолчанию уводит человека в системный экран без объяснений, и
        это выключено. Вместо этого в настройках есть понятный блок с
        объяснением и кнопкой. Не разрешили — напоминания работают неточно, и
        приложение об этом честно пишет.

        Для магазина: приложение не будильник и не календарь, поэтому
        `USE_EXACT_ALARM` не годится. `SCHEDULE_EXACT_ALARM` выдаёт человек, и
        напоминания о приёме лекарств — тот случай, ради которого он
        предусмотрен.
    -->
    <!--
      Камера — для снимка бланка анализа (0.32.0). Запрашивается в момент, когда
      человек нажал «Снять бланк», и только тогда: плагин просит разрешение сам.

      `<input type="file" capture>` вместо этого не годится — проверено на
      Mate 60 Pro: WebView Capacitor признак `capture` игнорирует и открывает
      проводник по документам.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Установка обновления из самого приложения.

      Приложение раздаётся файлом, магазина нет, и без этого права обновиться
      можно только получив APK от владельца и поставив руками. На семье из
      нескольких телефонов это значит, что часть из них вечно на старой
      версии — а старая версия ломает обмен (BACKLOG §24б) и молчит об этом.

      Разрешение спрашивается не при установке, а в момент, когда человек нажал
      «Обновить»: система сама отводит его на свой экран. Подпись проверяет
      система — файл с чужим ключом поверх дневника не встанет.

      ДЛЯ МАГАЗИНА. Google Play выдаёт это право неохотно: только магазинам и
      обоснованным самообновляющимся приложениям, через отдельную форму. При
      выходе в Play его, скорее всего, придётся убирать вместе с плагином
      `Updater` и разделом «Обновление» в настройках — там обновляет сам
      магазин, и своё становится лишним.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Чтение снимков из галереи. На Android 13 и новее — своё разрешение, на
      старых версиях его заменяет READ_EXTERNAL_STORAGE, поэтому у него потолок
      по версии: без него система на новых телефонах считает приложение
      требующим доступ ко всей памяти.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />

    <!--
        Ничего из железа не требуем обязательным.

        Разрешения тянут за собой неявные требования: из-за Bluetooth и
        геолокации магазин счёл бы приложение несовместимым с устройствами без
        радиомодуля или без GPS и просто не показал бы его там. Между тем
        дневник, ввод руками, графики и отчёт врачу работают на таком устройстве
        полностью — не работает только выгрузка с прибора.
    -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Камера появилась в 0.32.0 ради снимков бланков, а объявить её
         необязательной забыли: без этой строки магазин сочтёт приложение
         несовместимым с устройствами без камеры. Дневник давления работает и
         без неё — теряются только снимки. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
