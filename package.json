{
  "name": "dnevnik-zdorovya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Дневник артериального давления с прямой выгрузкой из Omron RS7 Intelli IT (HEM-6232T) по Web Bluetooth",
  "scripts": {
    "dev": "vite",
    "dev:lan": "LAN=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "drugs": "python3 tools/build_drugs.py --out public/drugs.json",
    "supplements": "python3 tools/build_supplements.py --out public/supplements.json",
    "visual": "bash tools/visual.sh",
    "icons": "python3 tools/icons.py && npx capacitor-assets generate --android",
    "release:android": "OMRON_RELEASE=1 npm run build && OMRON_RELEASE=1 npx cap sync android && cd android && ./gradlew assembleRelease --offline",
    "screens": "node tools/screens.mjs",
    "cloud": "node tools/cloud.mjs",
    "flow": "node tools/flow.mjs",
    "photos": "node tools/photos.mjs",
    "test:dst": "node tools/test-dst.mjs",
    "numbers": "node tools/numbers.mjs",
    "test:review": "node tests/review-integration.mjs && node tests/review-native-adapter.mjs && node tests/review-native-exact.mjs && node tests/review-photo-back.mjs",
    "test:update": "node tests/update-integration.mjs",
    "test:course-repeat": "node tests/course-repeat-ui.mjs",
    "test:cabinet": "node tests/cabinet-integration.mjs",
    "test:settings": "node tests/settings-ui.mjs",
    "test:charts": "node tests/charts-ui.mjs",
    "test:meals": "node tests/intake-meals-ui.mjs",
    "test:glucose": "node tests/glucose-memo-ui.mjs",
    "test:numeric": "node tests/numeric-report-ui.mjs",
    "test:ux": "node tests/ux-modes-ui.mjs && node tests/person-delete-ui.mjs && node tests/accessibility-fixes-ui.mjs && node tests/cjm-forms-ui.mjs && node tests/wheel-scale-ui.mjs",
    "test:offline": "node tests/offline-build.mjs",
    "test:modern": "node tests/modern-interface-ui.mjs",
    "test:cloud-web": "node tests/cloud-web-bootstrap.mjs && node tests/cloud-web-ui.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@percy/cli": "^1.32.6",
    "@percy/playwright": "^1.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "@capacitor/cli": "$@capacitor/cli"
  }
}
